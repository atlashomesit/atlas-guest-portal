// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Hero date picker > captures a stable mobile viewport snapshot > date-picker-mobile 1`] = `
"<div><section class="ahv2-hero w-full"><div class="ahv2-hero-left"><span class="ahv2-eyebrow ahv2-hero-eyebrow">Atlastays</span><h1 class="ahv2-hero-h1">Thoughtfully curated <span class="ahv2-city">stays in Hyderabad</span></h1><p class="ahv2-hero-sub">Direct from the owner — no platform fee, verified addresses, and WhatsApp-first support from a team that lives down the street.</p><div data-testid="hero-widget" class="ahv2-hero-widget"><form class="hero-form w-full max-w-5xl rounded-[24px] bg-[var(--bg-surface)] shadow-[var(--shadow-level-3)] backdrop-blur-sm border border-[var(--border-subtle)] p-8 flex flex-col gap-6" data-testid="search-input" id="search-form"><div class="sr-only" role="status" aria-live="polite">Hero form ready.</div><div class="hero-form-grid grid grid-cols-1 gap-6 md:grid-cols-2 md:auto-rows-fr lg:grid-cols-[1fr_1fr_1fr_1.4fr]"><div class="relative"><button type="button" class="field-card flex h-full min-h-[120px] flex-col justify-between rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-7 py-7 shadow-[var(--shadow-level-1)] hover:shadow-[var(--shadow-level-2)] hover:scale-[1.01] text-left transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta-secondary ring-2 ring-[var(--cta-primary)] ring-offset-2" aria-label="Click to select check-in date, then choose from calendar" title="Click to select check-in date, then choose from calendar" aria-expanded="true" data-testid="hero-date-toggle" aria-controls=":rid0:"><span class="flex items-center gap-2.5 text-[11px] font-bold uppercase tracking-[0.10em] text-[var(--text-muted)] whitespace-nowrap"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-range h-[18px] w-[18px] shrink-0 text-[var(--text-muted)]" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M16 2v4"></path><path d="M3 10h18"></path><path d="M8 2v4"></path><path d="M17 14h-6"></path><path d="M13 18H7"></path><path d="M7 14h.01"></path><path d="M17 18h.01"></path></svg><span class="truncate">Check-in</span></span><span class="date-value mt-4 flex items-center justify-between gap-2 text-[22px] font-medium text-[var(--text-primary)] leading-tight">15 Feb 2026<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-[18px] w-[18px] shrink-0 text-[var(--text-muted)] transition-transform duration-200 rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button></div><button type="button" class="field-card flex h-full min-h-[120px] flex-col justify-between rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-7 py-7 shadow-[var(--shadow-level-1)] hover:shadow-[var(--shadow-level-2)] hover:scale-[1.01] text-left transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta-secondary md:-ml-[1px]" aria-label="Click to select check-out date, then choose from calendar" title="Click to select check-out date, then choose from calendar" aria-expanded="true" aria-controls=":rid0:"><span class="flex items-center gap-2.5 text-[11px] font-bold uppercase tracking-[0.10em] text-[var(--text-muted)] whitespace-nowrap"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-range h-[18px] w-[18px] shrink-0 text-[var(--text-muted)]" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M16 2v4"></path><path d="M3 10h18"></path><path d="M8 2v4"></path><path d="M17 14h-6"></path><path d="M13 18H7"></path><path d="M7 14h.01"></path><path d="M17 18h.01"></path></svg><span class="truncate">Check-out</span></span><span class="date-value mt-4 flex items-center justify-between gap-2 text-[22px] font-medium text-[var(--text-primary)] leading-tight">16 Feb 2026<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-[18px] w-[18px] shrink-0 text-[var(--text-muted)] transition-transform duration-200 rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span><div class="mt-3 flex items-center justify-center"><span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--accent-primary)] bg-[var(--bg-muted)] px-3 py-1.5 rounded-lg">1 night</span></div></button><div class="relative"><button type="button" class="field-card flex h-full min-h-[120px] flex-col justify-between rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-7 py-7 shadow-[var(--shadow-level-1)] hover:shadow-[var(--shadow-level-2)] hover:scale-[1.01] text-left w-full transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--cta-primary)]" aria-expanded="false" aria-label="Select guests"><span class="flex items-center gap-2.5 text-[10px] font-bold uppercase tracking-[0.10em] text-[var(--text-muted)] whitespace-nowrap"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-[18px] w-[18px] shrink-0 text-[var(--text-muted)]" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg><span class="truncate">Guests</span></span><span class="guest-value mt-4 flex items-center justify-between gap-2 text-[22px] font-medium text-[var(--text-primary)] leading-tight">1 guest<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-[18px] w-[18px] shrink-0 text-[var(--text-muted)] transition-transform duration-200" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button></div><div class="field-card flex h-full min-h-[120px] flex-col justify-between rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-7 py-7 shadow-[var(--shadow-level-1)] hover:shadow-[var(--shadow-level-2)] hover:scale-[1.01] md:-ml-[1px] lg:min-h-[120px] lg:items-stretch lg:justify-center lg:flex-col"><button type="submit" data-testid="hero-search-submit" class="inline-flex h-[60px] w-full items-center justify-center rounded-[14px] bg-[var(--cta-primary)] px-6 text-base font-semibold tracking-[0.02em] text-white shadow-[var(--shadow-level-2)] transition-all hover:scale-[1.02] hover:shadow-[var(--shadow-level-3)] active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--cta-primary)] disabled:cursor-not-allowed disabled:opacity-60 disabled:shadow-none disabled:hover:scale-100 aria-busy:cursor-progress aria-busy:opacity-90 whitespace-nowrap" aria-busy="false">Check availability</button></div></div></form></div><ul class="ahv2-chip-row" role="list" aria-label="Booking guarantees"><li role="listitem" class="ahv2-chip"><span class="ahv2-tick" aria-hidden="true"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>Instant confirmation</li><li role="listitem" class="ahv2-chip"><span class="ahv2-tick" aria-hidden="true"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>Verified homes</li><li role="listitem" class="ahv2-chip"><span class="ahv2-tick" aria-hidden="true"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg></span>Free cancellation 48h before check-in</li></ul></div><div class="ahv2-hero-right"><div class="ahv2-hero-photo ahv2-hero-photo--fallback" aria-hidden="true"></div><div data-testid="hero-overlay" aria-hidden="true" class="ahv2-hero-overlay" style="background-image: url(&quot;linear-gradient-overlay&quot;);"></div></div></section></div><div class="fixed inset-0 pointer-events-none bg-transparent z-[90]" aria-hidden="true"></div><div role="dialog" aria-modal="true" aria-labelledby=":rid1:" id=":rid0:" tabindex="-1" class="booking-calendar-popover absolute z-[95] rounded-[20px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] shadow-[0_32px_96px_rgba(15,23,42,0.12),0_16px_48px_rgba(15,23,42,0.08)]" style="top: 230px; left: 12px; width: auto; min-width: 366px; max-width: min(640px, calc(100vw - 48px));"><div class="pointer-events-none absolute -top-2 h-4 w-4 rotate-45 border border-[var(--border-subtle)] border-b-transparent border-r-transparent bg-[var(--bg-surface)]" style="left: 310px;" aria-hidden="true"></div><div class="flex items-center justify-between px-6 py-5 border-b border-[var(--bg-muted)] bg-[var(--bg-surface)]"><div class="flex items-center gap-2"><p id=":rid1:" class="text-[17px] font-semibold text-[var(--text-primary)]">Choose your stay dates</p><span class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-[var(--border-subtle)] text-[11px] font-semibold text-[var(--text-muted)] p-2.5 -m-2.5" title="Click a date for check-in, then a later date for check-out." aria-label="Click to select check-in date, then choose from calendar">?</span></div></div><div class="max-h-[70vh] overflow-y-auto overflow-x-hidden p-5" style="pointer-events: auto;"><div class="mx-5 mt-4 mb-2 rounded-lg px-4 py-2 text-sm font-semibold bg-[#ffe8d6] text-[#c2410c]" aria-live="polite"><span class="mr-2 inline-block h-2.5 w-2.5 rounded-full bg-[#c2410c]" aria-hidden="true"></span>Range selected: 1 night</div><div class="mx-5 mb-3 flex flex-wrap gap-1.5" role="group" aria-label="Quick date presets"><button type="button" class="rounded-full px-3 py-1 text-xs font-medium transition-colors
              cursor-pointer bg-white text-[#475569] ring-1 ring-inset ring-[#f0e6dc] hover:bg-[#ffe8d6] hover:text-[#c2410c] hover:ring-[#c2410c] active:bg-[#ffe8d6]">Tonight</button><button type="button" class="rounded-full px-3 py-1 text-xs font-medium transition-colors
              cursor-pointer bg-white text-[#475569] ring-1 ring-inset ring-[#f0e6dc] hover:bg-[#ffe8d6] hover:text-[#c2410c] hover:ring-[#c2410c] active:bg-[#ffe8d6]">This weekend</button><button type="button" class="rounded-full px-3 py-1 text-xs font-medium transition-colors
              cursor-pointer bg-white text-[#475569] ring-1 ring-inset ring-[#f0e6dc] hover:bg-[#ffe8d6] hover:text-[#c2410c] hover:ring-[#c2410c] active:bg-[#ffe8d6]">Next weekend</button><button type="button" class="rounded-full px-3 py-1 text-xs font-medium transition-colors
              cursor-pointer bg-white text-[#475569] ring-1 ring-inset ring-[#f0e6dc] hover:bg-[#ffe8d6] hover:text-[#c2410c] hover:ring-[#c2410c] active:bg-[#ffe8d6]">This week</button><button type="button" class="rounded-full px-3 py-1 text-xs font-medium transition-colors
