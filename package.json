{
  "name": "atlas-guest-portal",
  "description": "Atlas Homestays guest-facing frontend for property discovery and booking",
  "keywords": [
    "atlas",
    "homestays",
    "booking",
    "react",
    "vite"
  ],
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "prebuild": "node scripts/verify-lockfile-linux-ci-deps.mjs && npm run validate:legal && node tools/optimize-images.mjs && node tools/generate-sitemap.mjs",
    "build": "node scripts/verify-pages-env.mjs && vite build",
    "build:functions": "wrangler pages functions build",
    "check:local-network": "node tools/check-local-network-apis.mjs",
    "test": "node node_modules/vitest/vitest.mjs run",
    "pretest": "npm run validate:legal",
    "lint": "eslint .",
    "format": "prettier -w .",
    "preview": "vite preview",
    "validate:legal": "cross-env CI=1 node node_modules/vitest/vitest.mjs run --config vitest.legal.config.ts --bail=1",
    "check:listing-id": "node scripts/check-listing-id-guardrail.mjs",
    "smoke:preview": "node scripts/smoke-preview-routes.mjs"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-linux-x64": "0.34.5",
    "@rollup/rollup-linux-x64-gnu": "4.60.3"
  },
  "overrides": {
    "@jridgewell/sourcemap-codec": "1.5.5",
    "dom-accessibility-api": "^0.6.3",
    "minimatch": ">=10.2.1"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fancyapps/ui": "^6.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/swiper": "^6.0.0",
    "axios": "^1.16.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "luxon": "^3.5.0",
    "pannellum": "^2.5.7",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-calendar": "^6.0.1",
    "react-date-range": "^2.0.1",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^4.1.3",
    "react-markdown": "^10.1.0",
    "react-motion-animate": "^1.0.6",
    "react-router-dom": "^6.28.0",
    "react-slick": "^0.31.0",
    "react-toastify": "^11.0.3",
    "slick-carousel": "^1.8.1",
    "swiper": "^12.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prettier": "^3.3.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  },
  "main": "eslint.config.js",
  "author": "",
  "license": "ISC"
}
