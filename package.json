{
  "name": "atlas-guest-portal",
  "description": "Atlas Homestays guest-facing frontend for property discovery and booking",
  "keywords": [
    "atlas",
    "homestays",
    "booking",
    "react",
    "vite"
  ],
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js --host",
    "prebuild": "node scripts/verify-lockfile-linux-ci-deps.mjs && npm run validate:legal && node tools/optimize-images.mjs && node tools/generate-sitemap.mjs",
    "build": "node scripts/verify-pages-env.mjs && vite build",
    "build:functions": "wrangler pages functions build",
    "check:local-network": "node tools/check-local-network-apis.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "pretest": "npm run validate:legal",
    "lint": "eslint .",
    "format": "prettier -w .",
    "preview": "vite preview",
    "validate:legal": "cross-env CI=1 node node_modules/vitest/vitest.mjs run --config vitest.legal.config.ts --bail=1",
    "check:listing-id": "node scripts/check-listing-id-guardrail.mjs",
    "smoke:preview": "node scripts/smoke-preview-routes.mjs"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3",
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  },
  "overrides": {
    "@jridgewell/sourcemap-codec": "1.5.5",
    "dom-accessibility-api": "^0.6.3",
    "minimatch": ">=10.2.1",
    "undici": "^7.28.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fancyapps/ui": "^6.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/swiper": "^6.0.0",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^1.23.0",
    "luxon": "^3.5.0",
    "pannellum": "^2.5.7",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-date-range": "^2.0.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^4.1.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-toastify": "^11.0.3",
    "swiper": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.106.0"
  },
  "main": "eslint.config.js",
  "author": "",
  "license": "ISC"
}
