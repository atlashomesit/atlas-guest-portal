  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fancyapps/ui": "^6.0.34",
    "@types/swiper": "^5.4.3",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.12.0",
    "lucide-react": "^0.484.0",
    "luxon": "^3.5.0",
    "react": "^18.3.1",
    "react-calendar": "^5.1.0",
    "react-date-range": "^2.0.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-motion-animate": "^1.0.6",
    "react-router-dom": "^6.28.0",
    "react-slick": "^0.31.0",
    "react-toastify": "^11.0.3",
    "slick-carousel": "^1.8.1",
    "swiper": "^11.2.0"
