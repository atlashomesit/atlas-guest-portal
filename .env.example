# Atlas Homestays Frontend - environment template
# Copy to .env.local and fill in values. Never commit .env.local.
# API base URL is configured at runtime via /.well-known/atlas-runtime-config.json (Cloudflare Pages).
# Set ATLAS_API_BASE_URL in Cloudflare Pages environment variables, not here.

# Optional: canonical site URL for structured data (defaults to window.location.origin, then marketplace).
# VITE_PUBLIC_SITE_ORIGIN=https://guest.yourdomain.com

# Admin portal base URL (Become a Host CTAs). Defaults to https://app.atlaspms.in when unset.
# VITE_ADMIN_PORTAL_URL=https://app.atlaspms.in

# Razorpay checkout
# TASK-288: In Cloudflare Pages DEV environment, this MUST be set to rzp_test_...
# (test key, not live). PROD uses rzp_live_... — set separately in PROD env.
VITE_RAZORPAY_KEY_ID=

# Support chat (Atlas Chat integration)
VITE_CHAT_API_URL=
VITE_ATLAS_AUTH_KEY=

# Analytics & monitoring
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=

# Date pricing multipliers (JSON override, optional)
VITE_DATE_MULTIPLIERS_JSON=

# Access control (comma-separated emails or JSON array, optional)
VITE_ALLOWED_EMAILS=

# Callback leads API endpoint (optional, defaults to /api/leads/callback)
VITE_CALLBACK_LEADS_ENDPOINT=/api/leads/callback
