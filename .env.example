# API surface consumed by the SPA. Must be set for both preview and production builds.
# If omitted, the app falls back to the production API host and logs a console warning.
VITE_API_BASE_URL=https://atlas-homes-api.example.com

# Google Maps JavaScript API key used on the Location page.
# Enable the Maps JavaScript API for the key, restrict it to the deployed domains (e.g., dev/prod Atlas Homestays hosts),
# and ensure billing is active so interactive maps load reliably.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_js_key

# Booking/contact forms (EmailJS)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_OWNER_EMAIL=owner@example.com

# Payments
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Optional/diagnostics
VITE_CALLBACK_LEADS_ENDPOINT=/api/leads/callback
VITE_ALLOWED_EMAILS=["a@example.com","b@example.com"]
VITE_SENTRY_DSN=your_sentry_dsn
