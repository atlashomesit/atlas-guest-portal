# Atlas Homestays Frontend - environment template
# Copy to .env and fill in values. Never commit .env.

# API (runtime config via /config.json for Cloudflare Pages; build-time fallback)
VITE_API_BASE_URL=http://localhost:5120
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# EmailJS (booking/contact forms)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_OWNER_EMAIL=

# Razorpay checkout
# TASK-288: In Cloudflare Pages DEV environment, this MUST be set to rzp_test_...
# (test key, not live). PROD uses rzp_live_... — set separately in PROD env.
# Without this, the guest checkout flow 500s on "create order" in the browser.
VITE_RAZORPAY_KEY_ID=

# Optional
VITE_CALLBACK_LEADS_ENDPOINT=/api/leads/callback
VITE_CHAT_API_URL=
VITE_ATLAS_AUTH_KEY=
VITE_SENTRY_DSN=
VITE_ALLOWED_EMAILS=
VITE_GA_MEASUREMENT_ID=
VITE_DATE_MULTIPLIERS_JSON=
