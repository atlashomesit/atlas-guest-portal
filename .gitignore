node_modules/
dist/

# agent-worktree.ps1 sandbox markers (atlas-e2e/scripts/agent-worktree.ps1) -- each describes ONE
# checkout's isolation/identity, never the repo. Gitignored fleet-wide 2026-09-26; previously only
# atlas-e2e's own .gitignore covered these, though agent-worktree.ps1 writes them into every repo's
# worktrees, this one included.
.atlas-sandbox
.atlas-agent-skill
# 2026-09-26 (later the same day): per-worktree scratch dir for throwaway agent files (dev-stack
# helper scripts, port-lock files, logs) that don't belong in the shared ambient scratchpad --
# see Get-AgentScratchDir in atlas-e2e/scripts/agent-worktree.ps1.
.agent-tmp/

.vscode/
.cursor/
.DS_Store
.env
.env.*
!.env.example

# Local dev logs
*.log

# Local preview build snapshots (operator scratch from wrangler/vite preview)
/atlas-guest-portal-preview-*/

# Cherry-pick session scratch (one-off operator artifacts)
/cherry-picks-*.txt

# Wrangler Pages Functions build output (regenerate via wrangler / CI; do not commit)
_worker.bundle
_worker.bundle/
_worker.bundledesktop.ini
*.ini
eslint-violations.json
# Wrangler local state/cache (regenerated locally; never commit)
.wrangler/

# Wrangler local secrets for `wrangler dev` (e.g. ATLAS_WORKER_PROXY_SECRET, TASK-7207).
# Real values live in `wrangler secret put` / Pages env vars — never commit them.
.dev.vars
.dev.vars.*

# Claude Design handoff bundles — scratch inbox, not source
Claude Design Patches/

# Optimized image output from tools/optimize-images.mjs (runs on every build via the
# `prebuild` script). For each raster source it writes a sibling named
# `<base>.<sha1-8-of-source>.webp`, so a NEW file appears whenever a source's bytes
# change — and orphans are only swept while the source still exists, so a renamed or
# deleted source leaves its .webp behind forever. Generated, not shipped: nothing reads
# the public/ output (manifest.webmanifest and index.html reference the .png sources
# directly, and optimize-images.mjs records only src/assets/ output in
# optimized-manifest.json). Safe to delete — `npm run build` regenerates them.
# NOTE: public/images/stay-bycityfocus-logo.*.webp were committed before this rule and
# stay tracked; .gitignore does not untrack them. Removing them is a separate change.
public/**/*.????????.webp
src/assets/**/*.????????.webp
